---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import { getLangFromUrl, useTranslations, getHref } from '@utils/i18n'
import PageTitleBand from '@components/PageTitleBand.astro'

const locale = getLangFromUrl(Astro.url)
const t = useTranslations(locale)
---

<DefaultLayout title="404" noindex>
  <PageTitleBand
    title="404"
    subtitle={t('page_404.message')}
    buttonHref={getHref('/', false, locale)}
    buttonLabel={t('back_home')}
  />
</DefaultLayout>
