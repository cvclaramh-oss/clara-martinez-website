---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import HomeView from '@views/HomeView.astro'
import ContactView from '@views/ContactView.astro'
import SitemapView from '@views/SitemapView.astro'
import ThankYouView from '@views/ThankYouView.astro'
import AccessibilityStatementView from '@views/AccessibilityStatementView.astro'
import ProjectsCatalogView from '@views/ProjectsCatalogView.astro'
import CatalogItemDetailView from '@views/CatalogItemDetailView.astro'
import ComingSoonView from '@views/ComingSoonView.astro'
import { getCatalogItemsByCategory, type CatalogItemCategory } from '@lib/sanity/catalogItemsQuery'
import { useTranslations } from '@utils/i18n'
import type { Locale } from '@utils/i18n'
import { routes } from '../i18n/routes'
import { CATALOGS_PAGE_SIZE, getTags, filterByTagSlug, type Tag } from '@utils/catalogUtils'
import { COMING_SOON_SECTIONS, SECTION_LABEL_KEYS } from '@constants/constLabels'

/**
 * Single catch-all router for every page in both locales.
 *
 * Generates localized URLs per language (see src/i18n/routes.ts) and renders
 * the matching page component. In SSG this is the only way to get different
 * translated slugs per locale without duplicating files.
 *
 * NOTE: Astro hoists getStaticPaths into its own scope, so locales and the
 * segment helper must live inside it (they cannot reference frontmatter vars).
 */

export async function getStaticPaths() {
  const locales: Locale[] = ['ca', 'es']

  const routeSegment = (locale: Locale, canonical: string): string =>
    (routes[locale] as Record<string, string>)[canonical] ?? canonical

  const paths: {
    params: { slug: string | undefined }
    props: {
      locale: Locale
      pageType: string
      pageNum?: number
      tag?: Tag
      category?: CatalogItemCategory
      itemSlug?: string
      itemTitle?: string
      section?: string
    }
  }[] = []

  const catalogCategories: CatalogItemCategory[] = ['projects', 'materials', 'formations', 'workshops']

  for (const locale of locales) {
    const prefix = locale === 'es' ? 'es/' : ''
    const projects = await getCatalogItemsByCategory(locale, 'projects')
    const uniqueTags = getTags(projects)

    for (const page of ['home', 'contact', 'sitemap', 'thank-you', 'accessibility-statement']) {
      paths.push({
        params: {
          slug: page === 'home' ? (locale === 'es' ? 'es' : undefined) : `${prefix}${routeSegment(locale, page)}`,
        },
        props: { locale, pageType: page },
      })
    }

    for (const section of COMING_SOON_SECTIONS) {
      paths.push({
        params: {
          slug: `${prefix}${routeSegment(locale, section)}`,
        },
        props: { locale, pageType: 'coming-soon', section },
      })
    }

    const projectsPages = Math.max(1, Math.ceil(projects.length / CATALOGS_PAGE_SIZE))
    for (let pageNum = 1; pageNum <= projectsPages; pageNum++) {
      paths.push({
        params: {
          slug: `${prefix}${routeSegment(locale, 'projects')}${pageNum > 1 ? `/${pageNum}` : ''}`,
        },
        props: { locale, pageType: 'projects', pageNum },
      })
    }

    for (const category of catalogCategories) {
      const items = category === 'projects' ? projects : await getCatalogItemsByCategory(locale, category)
      for (const item of items) {
        paths.push({
          params: {
            slug: `${prefix}${routeSegment(locale, category)}/${item.slug}`,
          },
          props: { locale, pageType: 'catalog-item', category, itemSlug: item.slug, itemTitle: item.data.title },
        })
      }
    }

    for (const tag of uniqueTags) {
      const tagProjects = filterByTagSlug(projects, tag.slug)
      const tagPages = Math.max(1, Math.ceil(tagProjects.length / CATALOGS_PAGE_SIZE))
      for (let pageNum = 1; pageNum <= tagPages; pageNum++) {
        const pageSuffix = pageNum > 1 ? `/${pageNum}` : ''
        paths.push({
          params: {
            slug: `${prefix}${routeSegment(locale, 'projects')}/${routeSegment(locale, 'tag')}/${tag.slug}${pageSuffix}`,
          },
          props: { locale, pageType: 'tag', tag, pageNum },
        })
      }
    }
  }

  return paths
}

interface Props {
  locale: Locale
  pageType: string
  pageNum?: number
  tag?: Tag
  category?: CatalogItemCategory
  itemSlug?: string
  itemTitle?: string
  section?: string
}

const { locale, pageType, pageNum = 1, tag, category, itemSlug, itemTitle, section } = Astro.props
const t = useTranslations(locale)

const isHome = pageType === 'home'
const sectionLabel = pageType === 'coming-soon' && section ? t(SECTION_LABEL_KEYS[section]) : undefined
const seoTitle = {
  home: t('meta.title'),
  projects: t('projects.label'),
  tag: tag ? `${t('projects.label')}: ${tag.label}` : t('projects.label'),
  'catalog-item': itemTitle ?? t('meta.title'),
  contact: t('contact.label'),
  sitemap: t('sitemap.label'),
  'thank-you': t('thank_you.title'),
  'accessibility-statement': t('accessibility.label'),
  'coming-soon': sectionLabel ? `${sectionLabel} · ${t('coming_soon.title')}` : t('coming_soon.title'),
}[pageType]

const seoDescription = {
  sitemap: t('sitemap.subtitle'),
  'accessibility-statement': t('accessibility.subtitle'),
}[pageType]
---

<DefaultLayout title={seoTitle} description={seoDescription} useTitleTemplate={!isHome}>
  {pageType === 'home' && <HomeView />}
  {pageType === 'projects' && <ProjectsCatalogView pageNum={pageNum} />}
  {pageType === 'tag' && tag && <ProjectsCatalogView pageNum={pageNum} currentTag={tag} />}
  {pageType === 'catalog-item' && category && itemSlug && <CatalogItemDetailView category={category} slug={itemSlug} />}
  {pageType === 'contact' && <ContactView />}
  {pageType === 'sitemap' && <SitemapView />}
  {pageType === 'thank-you' && <ThankYouView />}
  {pageType === 'accessibility-statement' && <AccessibilityStatementView />}
  {pageType === 'coming-soon' && section && <ComingSoonView sectionLabel={sectionLabel} />}
</DefaultLayout>
