---
import themeConfig from '@theme-config'
import { Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import { getLangFromUrl, useTranslations, getHref } from '@utils/i18n'

/**
 * Navigation Items Component
 *
 * @description A component that displays the navigation items for the website
 */

const locale = getLangFromUrl(Astro.url)
const t = useTranslations(locale)
---

<ul class="menu">
  {
    themeConfig.navigation.items.map((item) => (
      <li
        class={`menu-item ${item.type === 'dropdown' ? 'has-dropdown' : ''} ${item.icon ? 'type-icon animate-rotate' : ''}`}
      >
        {item.type === 'dropdown' ? (
          <button aria-haspopup="true" aria-expanded="false" class="menu-link">
            {t(item.label)}
            <Icon aria-hidden="true" name="lucide:chevron-down" size="16" />
          </button>
        ) : !item.type || item.type === 'link' ? (
          <Link
            href={getHref(item.href, item.external ?? false, locale)}
            isExternal={item.external ?? false}
            hideIcon={!!item.icon}
            class="menu-link"
          >
            {item.icon ? (
              <>
                <Icon aria-hidden="true" name={item.icon} size="32" />
                <span class="sr-only">{t(item.label)}</span>
              </>
            ) : (
              t(item.label)
            )}
          </Link>
        ) : null}
        {item.type === 'dropdown' && (
          <ul class="dropdown-menu">
            {item.items.map((subItem) => (
              <li class="submenu-item">
                <Link
                  href={getHref(subItem.href, subItem.external ?? false, locale)}
                  isExternal={subItem.external ?? false}
                  class="submenu-link"
                >
                  {t(subItem.label)}
                </Link>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ul>
