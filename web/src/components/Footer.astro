---
import CallToAction from './CallToAction.astro'
import { Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import { getLangFromUrl, useTranslations, getHref } from '@utils/i18n'
import themeConfig from '@theme-config'
import Button from '@components/Button.astro'
import { getCvFileUrl } from '@lib/sanity/siteSettingsQuery'
import { getExternalLinkAttributes } from '@utils/externalLinkAttributes'

/**
 * Footer Component
 *
 * @description Site footer: CTA band, 4-column info grid (brand, portfolio
 * index, contact, accessibility) and a bottom copyright bar.
 */

interface Props {
  /**
   * Whether to show the call-to-action band above the footer grid
   * @default true
   */
  showCallToAction?: boolean
}

const { showCallToAction = true } = Astro.props
const locale = getLangFromUrl(Astro.url)
const t = useTranslations(locale)
const currentYear = new Date().getFullYear()
const cvFileUrl = await getCvFileUrl()
---

<footer>
  {showCallToAction && <CallToAction />}

  <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[max-content_1fr_1fr_1fr]">
    <div class="cell flex flex-col gap-1">
      <p class="font-(family-name:--font-family-special) text-(length:--font-size-0) font-bold tracking-tight text-(--foreground-color) uppercase">
        {themeConfig.name}
      </p>
      <p class="micro-label text-(--color-on-surface-variant)">{t('tagline')}</p>
    </div>

    <div class="cell">
      <span class="micro-label mb-4 block text-(--color-accent-rose-dark)">
        {t('footer.portfolio_index')}
      </span>
      <ul class="columns-2 gap-x-4 text-(length:--font-size--2) font-bold tracking-wide uppercase">
        <li><Link href={getHref('/', false, locale)} class="footer-link">{t('home.label')}</Link></li>
        <li><Link href={getHref('/projects', false, locale)} class="footer-link">{t('projects.label')}</Link></li>
        <li><Link href={getHref('/materials', false, locale)} class="footer-link">{t('materials.label')}</Link></li>
        <li><Link href={getHref('/formations', false, locale)} class="footer-link">{t('formations.label')}</Link></li>
        <li><Link href={getHref('/workshops', false, locale)} class="footer-link">{t('workshops.label')}</Link></li>
        <li><Link href={getHref('/bio', false, locale)} class="footer-link">{t('bio.label')}</Link></li>
        <li><Link href={getHref('/contact', false, locale)} class="footer-link">{t('contact.label')}</Link></li>
      </ul>
    </div>

    <div class="cell flex flex-col gap-1">
      <div class="flex flex-col gap-2">
        <span class="micro-label block text-(--color-accent-rose-dark)">
          {t('footer.contact_heading')}
        </span>
        <Link href={`mailto:${themeConfig.contactEmail}`} class="footer-link text-(length:--font-size--1) font-bold tracking-wide">
          {themeConfig.contactEmail}
        </Link>
      </div>
      {
        themeConfig.socials && themeConfig.socials.length > 0 && (
          <ul class="flex flex-col gap-1 text-(length:--font-size--1)">
            {themeConfig.socials.map((social) => (
              <li>
                <Link href={social.href} isExternal={social.external} hideIcon class="footer-link text-(length:--font-size--2) font-bold tracking-wide uppercase">
                  {social.label}
                  {social.external && <span class="sr-only">{t('detail.new_tab')}</span>}
                </Link>
              </li>
            ))}
          </ul>
        )
      }
      <Button
        href={cvFileUrl ?? undefined}
        disabled={!cvFileUrl}
        {...(cvFileUrl ? getExternalLinkAttributes() : {})}
        size="sm"
        tone="ghost"
        class="w-fit"
      >
        <Icon aria-hidden="true" name="lucide:download" size={14} />
        {t('button_cv_download')}
        {cvFileUrl && <span class="sr-only">{t('detail.new_tab')}</span>}
      </Button>
    </div>

    <div class="cell flex flex-col gap-1">
      <div class="flex flex-col gap-2">
        <span class="micro-label block text-(--color-accent-rose-dark)">
          {t('footer.accessibility_heading')}
        </span>
        <p class="text-(length:--font-size--1) text-(--color-on-surface-variant)">{t('footer.accessibility_description')}</p>
        <Link
          href={getHref('/accessibility-statement', false, locale)}
          class="footer-link text-(length:--font-size--2) font-bold tracking-wide uppercase"
        >
          {t('accessibility.label')}
        </Link>
      </div>
      <span
        class="inline-block self-start border border-(--border-color) bg-(--color-surface-container-high) px-2 py-1 text-(length:--font-size--2) font-bold tracking-wide text-(--foreground-color) uppercase"
      >
        {t('footer.wcag_badge')}
      </span>
    </div>
  </section>

  <section
    class="flex flex-col items-center justify-center gap-2 border-t border-(--border-color) bg-(--color-surface-container-low) px-(--grid-gutter) py-4 text-center text-(length:--font-size--2) tracking-wide text-(--color-on-surface-variant) uppercase md:flex-row md:justify-between"
  >
    <p>&copy; {currentYear} {themeConfig.name}. {t('footer.rights')}</p>
    <Link href={getHref('/sitemap', false, locale)} class="footer-link">{t('sitemap.label')}</Link>
  </section>
</footer>

<style lang="scss">
  @use 'base/breakpoint' as *;

  // The -1px margin makes the top border overlap the bottom border of the last block of the page, so pages
  // that end with their own border do not show a double line above the CTA.
  footer {
    margin-block-start: -1px;
    border-block-start: 1px solid var(--border-color);
  }

  // Side padding follows the page margin (--grid-gutter).
  .cell {
    padding: var(--space-m) var(--grid-gutter);
    border-block-end: 1px solid var(--border-color);
  }

  @include breakpoint('m') {
    .cell {
      border-inline-end: 1px solid var(--border-color);
    }

    .cell:nth-child(2n) {
      border-inline-end: none;
    }
  }

  @include breakpoint('l') {
    .cell {
      border-block-end: none;
    }

    .cell:nth-child(2n) {
      border-inline-end: 1px solid var(--border-color);
    }

    .cell:last-child {
      border-inline-end: none;
    }
  }

  .footer-link {
    display: inline-block;
    padding-block: 0.375rem;
    color: var(--color-on-surface-variant);
    text-decoration: none;
    transition: none;
  }

  .footer-link:where(:hover, :focus-visible) {
    color: var(--foreground-color);
    text-decoration: underline;
  }
</style>
