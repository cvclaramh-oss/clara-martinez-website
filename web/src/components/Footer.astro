---
import CallToAction from './CallToAction.astro'
import { Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import { getLangFromUrl, useTranslations, getHref } from '@utils/i18n'
import themeConfig from '@theme-config'

/**
 * Footer Component
 *
 * @description Site footer: CTA band, 4-column info grid (brand, portfolio
 * index, contact, accessibility) and a bottom copyright bar.
 */

interface Props {
  /**
   * Whether to show the call-to-action band above the footer grid
   * @default true
   */
  showCallToAction?: boolean
}

const { showCallToAction = true } = Astro.props
const locale = getLangFromUrl(Astro.url)
const t = useTranslations(locale)
const currentYear = new Date().getFullYear()
---

<footer>
  {showCallToAction && <CallToAction />}

  <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[max-content_1fr_1fr_1fr]">
    <div class="cell flex flex-col gap-1">
      <p class="text-sm font-bold tracking-tight text-(--foreground-color) uppercase lg:text-lg">
        {themeConfig.name}
      </p>
      <p class="text-xs tracking-widest text-(--color-on-surface-variant) uppercase">{t('tagline')}</p>
    </div>

    <div class="cell">
      <span class="mb-4 block text-xs font-bold tracking-widest text-(--color-accent-rose-dark) uppercase">
        {t('footer.portfolio_index')}
      </span>
      <ul class="columns-2 gap-x-4 text-xs font-bold tracking-wide uppercase [&>li]:pb-1">
        <li><Link href={getHref('/', false, locale)} class="footer-link">{t('home.label')}</Link></li>
        <li><Link href={getHref('/projects', false, locale)} class="footer-link">{t('projects.label')}</Link></li>
        <li><Link href={getHref('/materials', false, locale)} class="footer-link">{t('materials.label')}</Link></li>
        <li><Link href={getHref('/formations', false, locale)} class="footer-link">{t('formations.label')}</Link></li>
        <li><Link href={getHref('/workshops', false, locale)} class="footer-link">{t('workshops.label')}</Link></li>
        <li><Link href={getHref('/bio', false, locale)} class="footer-link">{t('bio.label')}</Link></li>
        <li><Link href={getHref('/contact', false, locale)} class="footer-link">{t('contact.label')}</Link></li>
      </ul>
    </div>

    <div class="cell flex flex-col gap-1">
      <div class="flex flex-col gap-2">
        <span class="block text-xs font-bold tracking-widest text-(--color-accent-rose-dark) uppercase">
          {t('footer.contact_heading')}
        </span>
        <Link href={`mailto:${themeConfig.contactEmail}`} class="footer-link pt-2 text-sm font-bold tracking-wide">
          {themeConfig.contactEmail}
        </Link>
      </div>
      {
        themeConfig.socials && themeConfig.socials.length > 0 && (
          <ul class="flex flex-col gap-1 text-sm">
            {themeConfig.socials.map((social) => (
              <li>
                <Link href={social.href} isExternal={social.external} hideIcon class="footer-link pt-2 text-xs font-bold tracking-wide uppercase">
                  {social.label}
                </Link>
              </li>
            ))}
          </ul>
        )
      }
      {/* TODO: point href at Clara's real cvFile once Bio/Sanity is wired up. */}
      <Link
        href="#"
        class="footer-link mt-2 inline-flex w-fit items-center gap-1 border border-(--border-color) px-2 py-1 text-xs font-bold tracking-wide uppercase bg-(--color-surface-container-low) hover:bg-(--color-accent-rose) hover:text-(--color-on-accent)"
      >
        <Icon aria-hidden="true" name="lucide:download" size={14} />
        {t('button_cv_download')}
      </Link>
    </div>

    <div class="cell flex flex-col justify-between gap-6">
      <div class="flex flex-col gap-2">
        <span class="block text-xs font-bold tracking-widest text-(--color-accent-rose-dark) uppercase">
          {t('footer.accessibility_heading')}
        </span>
        <p class="text-sm text-(--color-on-surface-variant)">{t('footer.accessibility_description')}</p>
        <p class="pt-2 text-xs font-bold tracking-wide uppercase">
          <Link href={getHref('/accessibility-statement', false, locale)} class="footer-link">
            {t('accessibility.label')}
          </Link>
        </p>
      </div>
      <span
        class="inline-block self-start border border-(--border-color) bg-(--color-surface-container-high) px-2 py-1 text-xs font-bold tracking-wide text-(--foreground-color) uppercase"
      >
        {t('footer.wcag_badge')}
      </span>
    </div>
  </section>

  <section
    class="flex flex-col items-center justify-center gap-2 border-t border-(--border-color) bg-(--color-surface-container-low) px-4 py-4 text-center text-xs tracking-wide text-(--color-on-surface-variant) uppercase md:flex-row md:justify-between md:px-6 lg:px-8"
  >
    <p>&copy; {currentYear} {themeConfig.name}. {t('footer.rights')}</p>
    <Link href={getHref('/sitemap', false, locale)} class="footer-link">{t('sitemap.label')}</Link>
  </section>
</footer>

<style lang="scss">
  @use 'base/breakpoint' as *;

  // The -1px margin makes the top border overlap the bottom border of the last block of the page, so pages
  // that end with their own border do not show a double line above the CTA.
  footer {
    margin-block-start: -1px;
    border-block-start: 1px solid var(--border-color);
  }

  // Side padding follows the page margin (1rem, 1.5rem from `m`, 2rem from `l`).
  .cell {
    padding: 1.5rem 1rem;
    border-block-end: 1px solid var(--border-color);

    @include breakpoint('m') {
      padding-inline: 1.5rem;
    }

    @include breakpoint('l') {
      padding-inline: 2rem;
    }
  }

  @include breakpoint('m') {
    .cell {
      border-inline-end: 1px solid var(--border-color);
    }

    .cell:nth-child(2n) {
      border-inline-end: none;
    }
  }

  @include breakpoint('l') {
    .cell {
      border-block-end: none;
    }

    .cell:nth-child(2n) {
      border-inline-end: 1px solid var(--border-color);
    }

    .cell:last-child {
      border-inline-end: none;
    }
  }

  .footer-link {
    color: var(--color-on-surface-variant);
    text-decoration: none;
    transition: none;
  }

  .footer-link:where(:hover, :focus-visible) {
    color: var(--foreground-color);
    text-decoration: underline;
  }
</style>
