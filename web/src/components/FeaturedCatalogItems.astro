---
import { Card, Heading, Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import { getLangFromUrl, useTranslations, getHref } from '@utils/i18n'
import { getFeaturedCatalogItems } from '@lib/sanity/catalogItemsQuery'
import { urlFor } from '@lib/sanity/imageUrlBuilder'

/**
 * FeaturedCatalogItems Component
 *
 * @description Displays editor-curated projects (Sanity: featured == true,
 * ordered by featuredOrder), regardless of their category.
 */
interface Props {
  /**
   * Additional classes to apply to the section
   */
  class?: string
  /**
   * The number of projects to display
   * @default 3
   */
  limit?: number
  /**
   * The title for the section
   * @default "Featured projects"
   */
  title?: string
}

const locale = getLangFromUrl(Astro.url)
const t = useTranslations(locale)
const { class: className, limit = 3, title = t('featured_projects.title') } = Astro.props

const featuredCatalogItems = (await getFeaturedCatalogItems(locale)).slice(0, limit)
---

<section id="featured" class:list={[className, 'my-64 scroll-mt-16']}>
  <div class="container">
    <Heading level="h2" class="mb-6">{title}</Heading>
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3">
      {
        featuredCatalogItems.map((catalogItem) => (
          <Card
            img={urlFor(catalogItem.data.image, 640, 360)}
            imageAlt={catalogItem.data.imageAlt}
            url={getHref(`/${catalogItem.data.category}/${catalogItem.slug}`, false, locale)}
            headingLevel="h2"
            title={catalogItem.data.title}
            footer={catalogItem.data.author ? t('featured_projects.author_prefix') + catalogItem.data.author : undefined}
          >
            {catalogItem.data.subtitle}
          </Card>
        ))
      }
    </div>
    <div class="mt-12">
      <Link href={getHref('/projects', false, locale)} isButton animateOnHover animationType="nudge">
        {t('view_all_projects')}
        <Icon aria-hidden="true" name="lucide:arrow-right" size="1.5rem" />
      </Link>
    </div>
  </div>
</section>
