---
import CatalogCard from '@components/CatalogCard.astro'
import { getLangFromUrl, useTranslations } from '@utils/i18n'
import { getFeaturedCatalogItems } from '@lib/sanity/catalogItemsQuery'

/**
 * FeaturedCatalogItems Component
 *
 * @description Displays editor-curated projects (Sanity: featured == true,
 * ordered by featuredOrder), regardless of their category.
 */
interface Props {
  /**
   * Additional classes to apply to the section
   */
  class?: string
  /**
   * The number of projects to display
   * @default 6
   */
  limit?: number
  /**
   * The title for the section
   * @default the `featured_projects.title` text of the current language
   */
  title?: string
}

const locale = getLangFromUrl(Astro.url)
const t = useTranslations(locale)
const { class: className, limit = 6, title = t('featured_projects.title') } = Astro.props

const featuredCatalogItems = (await getFeaturedCatalogItems(locale)).slice(0, limit)
---

<section id="featured" class:list={[className, 'scroll-mt-16']}>
  <div
    class="flex flex-col justify-between gap-2 border-b border-(--border-color) px-4 py-4 md:flex-row md:items-end md:px-6 lg:px-8 lg:py-6"
  >
    <div>
      <div class="mb-1 flex items-center gap-1">
        <span class="inline-block h-2.5 w-2.5 bg-(--foreground-color)"></span>
        <span
          class="font-(family-name:--font-family-special) text-[0.6875rem] leading-3.5 font-bold tracking-widest text-(--color-accent-rose-dark) uppercase"
        >
          {t('featured_projects.eyebrow')}
        </span>
      </div>
      <h2
        class="tracking-tight text-(--foreground-color) uppercase"
      >
        {title}
      </h2>
    </div>
  </div>

  <div class="overflow-hidden">
    <div class="-mr-px grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
      {featuredCatalogItems.map((catalogItem) => <CatalogCard item={catalogItem} />)}
    </div>
  </div>

  <div class="h-20"></div>
</section>
