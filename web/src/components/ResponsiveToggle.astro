---
import { getLangFromUrl, useTranslations } from '@utils/i18n'

/**
 * ResponsiveToggle Component
 *
 * @description A toggle button for mobile navigation
 */
interface Props {
  /**
   * Additional classes to apply to the ResponsiveToggle
   */
  class?: string
}

const { class: className } = Astro.props
const locale = getLangFromUrl(Astro.url)
const t = useTranslations(locale)
---

<button
  class:list={[
    className,
    'responsive-toggle',
    'items-center justify-center h-full w-(--header-height) hover:bg-(--color-surface-container-low) transition-none',
  ]}
  aria-expanded="false"
  aria-label={t('nav.open_menu')}
  data-open-label={t('nav.open_menu')}
  data-close-label={t('nav.close_menu')}
>
  <svg width="26" height="21" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"
    ><path
      d="M2 1.667h24m-24 8h24m-24 8h24"
      stroke="var(--foreground-color)"
      stroke-width="2.667"
      stroke-linecap="round"
      stroke-linejoin="round"></path></svg
  >
</button>

<script>
  document.addEventListener('astro:page-load', () => {
    // variables
    const responsiveToggle = document.querySelector('.responsive-toggle') as HTMLButtonElement | null
    if (!responsiveToggle) return

    const openIconPath = 'M2 1.667h24m-24 8h24m-24 8h24'
    const closeIconPath = 'M10 10 2 2m8 8 8 8m-8-8 8-8m-8 8-8 8'

    // functions
    const setIconPath = (toggle: HTMLButtonElement, path: string) => {
      const icon = toggle.querySelector('svg')
      if (!icon) return

      icon.innerHTML = `<path d="${path}" stroke="var(--foreground-color)" stroke-width="2.667" stroke-linecap="round" stroke-linejoin="round"/>`
    }

    const openMenu = (toggle: HTMLButtonElement) => {
      toggle.setAttribute('aria-expanded', 'true')
      toggle.setAttribute('aria-label', toggle.dataset.closeLabel ?? '')
      setIconPath(toggle, closeIconPath)
    }

    const closeMenu = (toggle: HTMLButtonElement) => {
      toggle.setAttribute('aria-expanded', 'false')
      toggle.setAttribute('aria-label', toggle.dataset.openLabel ?? '')
      setIconPath(toggle, openIconPath)
    }

    // execution
    responsiveToggle.addEventListener('click', () => {
      const mobileNavigation = document.querySelector('.mobile-menu')
      if (!mobileNavigation) return

      mobileNavigation.classList.toggle('show')
      if (mobileNavigation.classList.contains('show')) {
        openMenu(responsiveToggle)
      } else {
        closeMenu(responsiveToggle)
      }
    })
  })
</script>

<style lang="scss">
  .responsive-toggle {
    border: none;
    background: transparent;
    padding: 0;
  }
</style>
