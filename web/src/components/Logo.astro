---
import { Link } from 'accessible-astro-components'
import themeConfig from '@theme-config'
import { getLangFromUrl, useTranslations, getHref } from '@utils/i18n'

/**
 * Logo Component
 *
 * @description Brand cell (logo). The tagline stacks under the name, inside the
 * same cell, up to 1439px (the name is 13px below the `nav` breakpoint and 20px
 * from it). From 1440px the cell is a single line and the tagline gets its own
 * separate bordered cell (see .tagline below), so the desktop menu keeps room.
 */

const locale = getLangFromUrl(Astro.url)
const t = useTranslations(locale)
---

<Link href={getHref('/', false, locale)} class="brand-link flex h-full px-4 hover:bg-(--color-surface-container-low) transition-none">
  <span
    class="brand-name font-(family-name:--font-family-special) font-bold uppercase tracking-tight text-(--foreground-color) whitespace-nowrap"
  >
    {themeConfig.name}
  </span>
  <span
    class="brand-tagline font-(family-name:--font-family-special) font-bold uppercase tracking-widest text-(--color-on-surface-variant) whitespace-nowrap"
  >
    {t('tagline')}
  </span>
</Link>
<span
  class="tagline hidden min-[1440px]:flex items-center h-full px-4 border-r border-(--border-color) bg-(--color-surface-container-low) font-(family-name:--font-family-special) text-[0.6875rem] leading-3.5 font-bold uppercase tracking-widest text-(--color-on-surface-variant) whitespace-nowrap"
>
  {t('tagline')}
</span>

<style lang="scss">
  @use 'base/breakpoint' as *;

  .brand-link {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.125rem;

    @include breakpoint('nav') {
      border-inline-end: 1px solid var(--border-color);
    }

    @include breakpoint(1440px) {
      flex-direction: row;
      align-items: center;
      gap: 0;
    }
  }

  .brand-name {
    font-size: 0.8125rem;
    line-height: 1rem;

    @include breakpoint('nav') {
      font-size: 1.25rem;
      line-height: 1.625rem;
    }
  }

  .brand-tagline {
    font-size: 0.5625rem;
    line-height: 0.75rem;

    @include breakpoint('nav') {
      font-size: 0.6875rem;
      line-height: 0.875rem;
    }

    @include breakpoint(1440px) {
      display: none;
    }
  }
</style>
