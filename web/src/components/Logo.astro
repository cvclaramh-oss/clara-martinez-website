---
import { Link } from 'accessible-astro-components'
import themeConfig from '@theme-config'
import { getLangFromUrl, getHref } from '@utils/i18n'

/**
 * Logo Component
 *
 * @description Logo description
 */

const locale = getLangFromUrl(Astro.url)
---

<Link
  href={getHref('/', false, locale)}
  class="font-[family-name:var(--font-family-special)] text-[1.25rem] leading-[1.625rem] uppercase tracking-tight text-[var(--foreground-color)] font-bold whitespace-nowrap"
>
  {themeConfig.name}
</Link>
