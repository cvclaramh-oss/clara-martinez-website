---
import { Link } from 'accessible-astro-components'
import themeConfig from '@theme-config'
import { getLangFromUrl, useTranslations, getHref } from '@utils/i18n'

/**
 * Logo Component
 *
 * @description Brand cell (logo). Name and tagline use the fluid type scale (`--font-size-0`, `--font-size--2`).
 * The tagline is stacked under the name, inside the same cell, below `tagline-s` and from the `nav` breakpoint
 * up to `tagline`, where there is no room for another cell. From `tagline-s` up to `nav` and from `tagline` up
 * the cell is a single line and the tagline gets its own bordered cell (see .tagline below). The widths come
 * from the map in styles/base/_breakpoint.scss, measured with the longest tagline (es).
 */

const locale = getLangFromUrl(Astro.url)
const t = useTranslations(locale)
---

<Link href={getHref('/', false, locale)} class="brand-link flex h-full ps-(--grid-gutter) pe-4 hover:bg-(--color-surface-container-low) transition-none">
  <span
    class="brand-name font-(family-name:--font-family-special) font-bold uppercase tracking-tight text-(--foreground-color) whitespace-nowrap"
  >
    {themeConfig.name}
  </span>
  <span
    class="brand-tagline micro-label text-(--color-on-surface-variant) whitespace-nowrap"
  >
    {t('tagline')}
  </span>
</Link>
<span
  class="tagline items-center h-full px-4 border-r border-(--border-color) bg-(--color-surface-container-low) micro-label text-(--color-on-surface-variant) whitespace-nowrap"
>
  {t('tagline')}
</span>

<style lang="scss">
  @use 'base/breakpoint' as *;

  // The tagline is stacked under the name below `tagline-s` and while the desktop menu leaves no room for a cell
  // (from `nav` up to `tagline`); it is its own cell from `tagline-s` up to `nav` and from `tagline` up.
  .brand-link {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.125rem;

    @include breakpoint('tagline-s') {
      border-inline-end: 1px solid var(--border-color);
    }

    @include breakpoint('tagline-s', 'nav') {
      flex-direction: row;
      align-items: center;
      gap: 0;
    }

    @include breakpoint('tagline') {
      flex-direction: row;
      align-items: center;
      gap: 0;
    }
  }

  .brand-name {
    font-size: var(--font-size-0);
    line-height: var(--font-size-1);
  }

  .brand-tagline {
    @include breakpoint('tagline-s', 'nav') {
      display: none;
    }

    @include breakpoint('tagline') {
      display: none;
    }
  }

  .tagline {
    display: none;

    @include breakpoint('tagline-s', 'nav') {
      display: flex;
    }

    @include breakpoint('tagline') {
      display: flex;
    }
  }
</style>
