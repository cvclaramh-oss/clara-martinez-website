---
import { Link } from 'accessible-astro-components'
import themeConfig from '@theme-config'
import { getLangFromUrl, useTranslations, getHref } from '@utils/i18n'

/**
 * Logo Component
 *
 * @description Brand cell (logo). The tagline is stacked under the name, inside the same cell, on mobile
 * (name 13px) and from the `nav` breakpoint up to `tagline` (name 20px), where the desktop menu leaves no
 * room for another cell. On tablet (`m` up to `nav`) and from `tagline` up the cell is a single line and
 * the tagline gets its own bordered cell (see .tagline below). All three widths come from the map in
 * styles/base/_breakpoint.scss.
 */

const locale = getLangFromUrl(Astro.url)
const t = useTranslations(locale)
---

<Link href={getHref('/', false, locale)} class="brand-link flex h-full px-4 hover:bg-(--color-surface-container-low) transition-none">
  <span
    class="brand-name font-(family-name:--font-family-special) font-bold uppercase tracking-tight text-(--foreground-color) whitespace-nowrap"
  >
    {themeConfig.name}
  </span>
  <span
    class="brand-tagline font-(family-name:--font-family-special) font-bold uppercase tracking-widest text-(--color-on-surface-variant) whitespace-nowrap"
  >
    {t('tagline')}
  </span>
</Link>
<span
  class="tagline items-center h-full px-4 border-r border-(--border-color) bg-(--color-surface-container-low) font-(family-name:--font-family-special) text-[0.6875rem] leading-3.5 font-bold uppercase tracking-widest text-(--color-on-surface-variant) whitespace-nowrap"
>
  {t('tagline')}
</span>

<style lang="scss">
  @use 'base/breakpoint' as *;

  // The tagline is stacked under the name on mobile and while the desktop menu leaves no room for a cell
  // (from `nav` up to `tagline`); it is its own cell on tablet and from `tagline` up.
  .brand-link {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.125rem;

    @include breakpoint('m') {
      border-inline-end: 1px solid var(--border-color);
    }

    @include breakpoint('m', 'nav') {
      flex-direction: row;
      align-items: center;
      gap: 0;
    }

    @include breakpoint('tagline') {
      flex-direction: row;
      align-items: center;
      gap: 0;
    }
  }

  .brand-name {
    font-size: 0.8125rem;
    line-height: 1rem;

    @include breakpoint('m') {
      font-size: 1.25rem;
      line-height: 1.625rem;
    }
  }

  .brand-tagline {
    font-size: 0.5625rem;
    line-height: 0.75rem;

    @include breakpoint('nav') {
      font-size: 0.6875rem;
      line-height: 0.875rem;
    }

    @include breakpoint('m', 'nav') {
      display: none;
    }

    @include breakpoint('tagline') {
      display: none;
    }
  }

  .tagline {
    display: none;

    @include breakpoint('m', 'nav') {
      display: flex;
    }

    @include breakpoint('tagline') {
      display: flex;
    }
  }
</style>
