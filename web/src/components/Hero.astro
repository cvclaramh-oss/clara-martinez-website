---
import { Icon } from 'astro-icon/components'
import { getLangFromUrl, useTranslations } from '@utils/i18n'
import Button from '@components/Button.astro'

/**
 * Hero Component
 *
 * @description A component that displays a hero section with a title, description and a link to the featured content
 */

const locale = getLangFromUrl(Astro.url)
const t = useTranslations(locale)
const [firstName, ...surnames] = t('name').split(' ')
---

<section class="hero border-b border-(--border-color)">
  <div class="px-(--grid-gutter) pt-(--space-xl-2xl) pb-(--space-m-xl)">
    <h1
      class="text-[clamp(3.25rem,1.8587rem+6.9565vw,7.25rem)] leading-[0.88] tracking-[-0.04em] text-(--foreground-color) uppercase"
    >
      <span class="block">{firstName}</span>
      <span class="block">{surnames.join(' ')}</span>
    </h1>

    <div class="mt-(--space-m-l) flex flex-wrap items-center gap-2">
      <div class="h-1 w-4 border border-(--border-color) bg-(--color-accent-rose)"></div>
      <p
        class="font-(family-name:--font-family-special) text-(length:--font-size--1) font-bold tracking-[0.2em] text-(--foreground-color) uppercase"
      >
        {t('tagline')}
      </p>
    </div>

    <div class="my-(--space-m) w-full border-t border-(--border-color)"></div>

    <div class="grid grid-cols-1 items-end gap-(--space-m) lg:grid-cols-12">
      <p
        class="max-w-4xl font-(family-name:--font-family-special) text-(length:--font-size-2) leading-[1.3] font-medium text-(--foreground-color) lg:col-span-8 lg:tracking-[-0.01em]"
      >
        {t('short_bio')}
      </p>

      <div class="flex flex-col items-stretch md:flex-row md:justify-end lg:col-span-4">
        <Button href="#featured" size="md" tone="accent" class="w-full md:w-fit">
          {t('view_featured')}
          <Icon aria-hidden="true" name="lucide:arrow-down" size="1rem" />
        </Button>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  h1 {
    text-wrap: unset;
  }
</style>
