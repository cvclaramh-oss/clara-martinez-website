---
import { Heading } from 'accessible-astro-components'
import { getLangFromUrl, useTranslations, getHref } from '@utils/i18n'
import Button from '@components/Button.astro'

/**
 * CallToAction Component
 *
 * @description Monolithic call-to-action block shown right before the footer
 * on every page, inviting collaboration/hiring enquiries.
 */

const locale = getLangFromUrl(Astro.url)
const t = useTranslations(locale)
---

<section class="cta px-4 md:px-6 lg:px-8">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 py-12 md:py-16">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div class="flex-1">
        <div class="mb-2 flex items-center gap-2">
          <span class="inline-block h-3 w-3 bg-(--color-on-accent)"></span>
          <span class="text-xs font-bold tracking-widest text-(--color-on-accent) uppercase">
            {t('footer.cta_eyebrow')}
          </span>
        </div>
        <Heading
          level="h2"
          class="text-wrap! text-(length:--font-size-3) leading-(--font-size-3) tracking-tight uppercase"
        >
          {t('footer.cta_heading')}
        </Heading>
      </div>
    </div>
    <div class="flex flex-col gap-4 md:flex-row md:justify-between">
      <p class="max-w-2xl text-(--color-on-accent)">{t('footer.cta_description')}</p>
      <Button href={getHref('/contact', false, locale)} class="self-start whitespace-nowrap">
        {t('footer.cta_button')}
      </Button>
    </div>
  </div>
</section>

<style>
  .cta {
    background-color: var(--color-accent-rose);
    color: var(--color-on-accent);
    border-block-end: 1px solid var(--border-color);
  }
</style>
