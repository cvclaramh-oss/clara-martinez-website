---
import PageHeader from '@components/PageHeader.astro'
import SocialShares from '@components/SocialShares.astro'
import { Heading, Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import { getLangFromUrl, useTranslations, getHref } from '@utils/i18n'
import { getProjectsByCategory } from '@lib/sanity/catalogItemsQuery'
import { urlFor } from '@lib/sanity/imageUrlBuilder'
import { portableTextToHtml } from '@lib/sanity/renders/portableTextRender'

/**
 * ProjectDetail Component
 *
 * @description Renders a single project with its content and share actions.
 * All internal links are localized through getHref.
 */
interface Props {
  /**
   * The id of the project to render
   */
  projectId: string
}

const locale = getLangFromUrl(Astro.url)
const t = useTranslations(locale)
const { projectId } = Astro.props

const projects = await getProjectsByCategory(locale, 'projects')
const project = projects.find((entry) => entry.slug === projectId)
const bodyHtml = project ? portableTextToHtml(project.data.descriptionLong) : ''

const author = {
  name: project?.data.author ?? '',
  image: '/projects/project-image-1.png',
  bio: 'Project Creator',
}
---

{
  project && (
    <>
      <PageHeader
        title={project.data.title}
        subtitle={project.data.subtitle}
        author={author}
        bgType="bordered"
        featuredImage={urlFor(project.data.image, 1200, 250)}
        customBreadcrumbLabels={{ [project.slug]: project.data.title }}
      />
      <section class="my-12">
        <div class="narrow space-content container" set:html={bodyHtml} />
      </section>
      <section class="my-12">
        <div class="narrow space-content container">
          <Heading level="h2">{t('project_share.title')}</Heading>
          <p>{t('project_share.description')}</p>
          <SocialShares />
          <Link href={getHref('/projects', false, locale)} isButton type="secondary" animateOnHover animationType="nudge">
            <Icon aria-hidden="true" name="lucide:arrow-left" size={20} />
            {t('project_share.back')}
          </Link>
        </div>
      </section>
    </>
  )
}

<style lang="scss" is:global>
  .narrow {
    margin-inline: auto;
    max-width: 65ch;
  }
</style>