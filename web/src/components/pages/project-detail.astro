---
import PageHeader from '@components/PageHeader.astro'
import SocialShares from '@components/SocialShares.astro'
import { Heading, Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import { getCollection, render } from 'astro:content'
import { getLangFromUrl, useTranslations, getHref } from '@utils/i18n'

import projectImage1 from '@assets/images/projects/project-image-1.png'
import projectImage2 from '@assets/images/projects/project-image-2.png'
import projectImage3 from '@assets/images/projects/project-image-3.png'
import projectImage4 from '@assets/images/projects/project-image-4.png'
import projectImage5 from '@assets/images/projects/project-image-5.png'
import projectImage6 from '@assets/images/projects/project-image-6.png'

/**
 * ProjectDetail Component
 *
 * @description Renders a single project with its content and share actions.
 * All internal links are localized through getHref.
 */
interface Props {
  /**
   * The id of the project to render
   */
  projectId: string
}

const locale = getLangFromUrl(Astro.url)
const t = useTranslations(locale)
const { projectId } = Astro.props

const projects = (await getCollection('projects')).sort((a, b) => a.id.localeCompare(b.id))
const project = projects.find((entry) => entry.id === projectId)
const { Content } = project ? await render(project) : { Content: () => null }

const projectImages = [projectImage1, projectImage2, projectImage3, projectImage4, projectImage5, projectImage6]
const projectIndex = Math.max(0, projects.findIndex((entry) => entry.id === projectId))
const featuredImage = projectImages[projectIndex % projectImages.length]

const author = {
  name: project?.data.author ?? '',
  image: '/projects/project-image-1.png',
  bio: 'Project Creator',
}
---

{
  project && (
    <>
      <PageHeader
        title={project.data.title}
        subtitle={project.data.description}
        author={author}
        bgType="bordered"
        featuredImage={featuredImage}
        customBreadcrumbLabels={{ [project.id]: project.data.title }}
      />
      <section class="my-12">
        <div class="narrow space-content container">
          <Content />
        </div>
      </section>
      <section class="my-12">
        <div class="narrow space-content container">
          <Heading level="h2">{t('project_share.title')}</Heading>
          <p>{t('project_share.description')}</p>
          <SocialShares />
          <Link href={getHref('/projects', false, locale)} isButton type="secondary" animateOnHover animationType="nudge">
            <Icon aria-hidden="true" name="lucide:arrow-left" size={20} />
            {t('project_share.back')}
          </Link>
        </div>
      </section>
    </>
  )
}

<style lang="scss" is:global>
  .narrow {
    margin-inline: auto;
    max-width: 65ch;
  }
</style>