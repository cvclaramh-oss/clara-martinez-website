---
import PageHeader from '@components/PageHeader.astro'
import { Badge, Card, Heading, Link, Pagination } from 'accessible-astro-components'
import { getCollection } from 'astro:content'
import { getLangFromUrl, useTranslations, getHref } from '@utils/i18n'
import { PROJECTS_PAGE_SIZE, getTags, filterByTagSlug, type Tag } from '@utils/projects'

import projectImage1 from '@assets/images/projects/project-image-1.png'
import projectImage2 from '@assets/images/projects/project-image-2.png'
import projectImage3 from '@assets/images/projects/project-image-3.png'
import projectImage4 from '@assets/images/projects/project-image-4.png'
import projectImage5 from '@assets/images/projects/project-image-5.png'
import projectImage6 from '@assets/images/projects/project-image-6.png'

/**
 * ProjectListing Component
 *
 * @description Renders the project collection, optionally filtered by tag,
 * with pagination. All internal links are localized through getHref.
 */
interface Props {
  /**
   * The page number of the listing to render
   * @default 1
   */
  pageNum?: number
  /**
   * The tag to filter projects by
   */
  currentTag?: Tag
}

const locale = getLangFromUrl(Astro.url)
const t = useTranslations(locale)
const { pageNum = 1, currentTag } = Astro.props

const projects = (await getCollection('projects')).sort((a, b) => a.id.localeCompare(b.id))
const uniqueTags = getTags(projects)

const filteredProjects = currentTag ? filterByTagSlug(projects, currentTag.slug) : projects
const totalPages = Math.max(1, Math.ceil(filteredProjects.length / PROJECTS_PAGE_SIZE))
const startIndex = (pageNum - 1) * PROJECTS_PAGE_SIZE
const pageProjects = filteredProjects.slice(startIndex, startIndex + PROJECTS_PAGE_SIZE)

const projectImages = [projectImage1, projectImage2, projectImage3, projectImage4, projectImage5, projectImage6]

const pageProjectsWithImages = pageProjects.map((project, index) => ({
  ...project,
  featuredImage: projectImages[(startIndex + index) % projectImages.length],
}))

const plural = (count: number) => (count === 1 ? t('projects.one') : t('projects.many'))

function pageHref(page: number, tag?: Tag): string {
  const root = tag ? `/projects/tag/${tag.slug}` : '/projects'
  return getHref(page === 1 ? root : `${root}/${page}`, false, locale)
}

const headerTitle = currentTag ? `${t('projects.title')}: ${currentTag.label}` : t('projects.title')
const headerSubtitle = currentTag
  ? `${t('tag.subtitle_prefix')} «${currentTag.label}». ${filteredProjects.length} ${plural(filteredProjects.length)}`
  : t('projects.subtitle')
---

<PageHeader
  title={headerTitle}
  subtitle={headerSubtitle}
  bgType="bordered"
  customBreadcrumbLabels={currentTag ? { [currentTag.slug]: currentTag.label } : undefined}
  joinLastBreadcrumb={!!currentTag}
/>

<section class="my-12">
  <div class="container">
    <Heading level="h2" size="h5" class="mb-2">{t('projects.tags')}</Heading>
    <div class="flex flex-wrap gap-4">
      <Link href={getHref('/projects', false, locale)}>{t('projects.all')}</Link>
      {
        uniqueTags.map((tag) => {
          const isCurrentTag = tag.slug === currentTag?.slug
          return (
            <Link href={pageHref(1, tag)} ariaCurrent={isCurrentTag ? 'page' : undefined}>
              {tag.label}
            </Link>
          )
        })
      }
    </div>
    <p class="mt-8 text-sm">
      <em>
        {t('projects.range_prefix')} {startIndex + 1}–{startIndex + pageProjects.length} {t('projects.range_suffix')}{' '}
        {filteredProjects.length} {plural(filteredProjects.length)}
      </em>
    </p>
    <ul class="mt-3 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        pageProjectsWithImages.map((project) => (
          <li>
            <Card
              imageComponent={project.featuredImage}
              url={getHref(`/projects/${project.id}`, false, locale)}
              title={project.data.title}
              headingLevel="h2"
              footer={t('featured_projects.author_prefix') + project.data.author}
              fullHeight={true}
            >
              <span slot="meta">
                {project.data.tags.map((tag) => (
                  <Badge>{tag}</Badge>
                ))}
              </span>
              {project.data.description}
            </Card>
          </li>
        ))
      }
    </ul>
    {
      totalPages > 1 && (
        <div class="mt-12 grid place-content-center">
          <Pagination
            firstPage={pageNum > 1 ? pageHref(1, currentTag) : null}
            previousPage={pageNum > 1 ? pageHref(pageNum - 1, currentTag) : null}
            nextPage={pageNum < totalPages ? pageHref(pageNum + 1, currentTag) : null}
            lastPage={pageNum < totalPages ? pageHref(totalPages, currentTag) : null}
            currentPage={`${pageNum}`}
            totalPages={`${totalPages}`}
            ariaLabel={t('projects.pagination_aria')}
          />
        </div>
      )
    }
  </div>
</section>