---
import { getLangFromUrl, useTranslations, getHref } from '@utils/i18n'
import type { CatalogTag } from '@utils/catalogTags'
import type { CatalogPage } from '@constants/constCatalog'

/**
 * TagFilterBar Component
 *
 * @description Chip list to filter a catalog listing by tag; each chip links to its own page
 * (`<catalogPage>/etiqueta/<slug>`, see ADR 0019), plus a chip to clear the filter.
 */
interface Props {
  tags: CatalogTag[]
  activeSlug?: string
  catalogPage: CatalogPage
}

const locale = getLangFromUrl(Astro.url)
const t = useTranslations(locale)
const { tags, activeSlug, catalogPage } = Astro.props

const labelClass =
  'font-(family-name:--font-family-special) text-[0.6875rem] leading-3.5 font-bold tracking-widest uppercase'

const chipClass = (isActive: boolean) =>
  `border px-2 py-1 no-underline! ${labelClass} ${
    isActive
      ? 'border-(--foreground-color) bg-(--foreground-color) text-(--background-color)!'
      : 'border-(--border-color) text-(--foreground-color)! hover:bg-(--color-surface-container-high)'
  }`
---

<nav
  aria-label={t('catalog.tag_filter_aria')}
  class="border-b border-(--border-color) bg-(--color-surface-container-low) px-4 py-2 md:px-6 lg:px-8"
>
  <ul class="flex flex-wrap gap-2">
    <li>
      <a href={getHref(`/${catalogPage}`, false, locale)} class={chipClass(!activeSlug)}>
        {t('catalog.tag_all')}
      </a>
    </li>
    {
      tags.map((tag) => (
        <li>
          <a
            href={getHref(`/${catalogPage}/tag/${tag.slug}`, false, locale)}
            class={chipClass(tag.slug === activeSlug)}
          >
            #{tag.text}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
