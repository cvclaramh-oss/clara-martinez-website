---
import { getLangFromUrl, localizeUrl, useTranslations } from '@utils/i18n'
import type { Locale } from '@utils/i18n'
import { getAlternateItemHref } from '@lib/sanity/translationsQuery'

/**
 * Language Picker Component
 *
 * @description Switches between the Catalan and Spanish versions of the current page. On the detail page of a
 * catalog item the slug differs between languages, so the link comes from the item's linked translation (or the
 * catalog page if it has none) instead of from translating the path.
 */

const locale = getLangFromUrl(Astro.url)
const t = useTranslations(locale)

const getHref = async (target: Locale) =>
  target === locale
    ? localizeUrl(Astro.url.pathname, target)
    : ((await getAlternateItemHref(Astro.url.pathname, target)) ?? localizeUrl(Astro.url.pathname, target))

const caHref = await getHref('ca')
const esHref = await getHref('es')
---

<ul class="language-picker nav-action-cell">
  <li>
    <a
      href={caHref}
      aria-current={locale === 'ca' ? 'page' : undefined}
      aria-label={t('nav.lang_ca')}
      class:list={['lang-link', { 'is-active': locale === 'ca' }]}
    >
      CA
    </a>
  </li>
  <li>
    <a
      href={esHref}
      aria-current={locale === 'es' ? 'page' : undefined}
      aria-label={t('nav.lang_es')}
      class:list={['lang-link', { 'is-active': locale === 'es' }]}
    >
      ES
    </a>
  </li>
</ul>

<style lang="scss">
  .language-picker {
    display: flex;
    align-items: center;
    list-style-type: none;
    font-family: var(--font-family-special);
    font-size: var(--font-size--2);
    line-height: 1rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;

    li:last-child {
      margin-inline-start: 0.5rem;
      padding-inline-start: 0.5rem;
      border-inline-start: 1px solid var(--border-color-subtle);
    }
  }

  // Hangs from #main-navigation: the global `#main-navigation a { color }` rule would beat a plain class.
  :global(#main-navigation) .lang-link {
    display: inline-flex;
    padding: 0.125rem 0.25rem;
    color: var(--color-on-surface-variant);
    transition: none;

    &:where(:hover, :focus-visible) {
      color: var(--foreground-color);
    }

    &.is-active {
      background-color: var(--color-accent-rose);
      color: var(--color-on-accent);
      font-weight: 700;
    }
  }
</style>
