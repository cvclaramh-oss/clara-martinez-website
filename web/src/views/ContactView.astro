---
import ContactForm from '@components/ContactForm.astro'
import { Icon } from 'astro-icon/components'
import { getLangFromUrl, useTranslations, getHref } from '@utils/i18n'
import themeConfig from '@theme-config'
import Button from '@components/Button.astro'
import Breadcrumb from '@components/Breadcrumb.astro'
import PageTitleBand from '@components/PageTitleBand.astro'
import Eyebrow from '@components/Eyebrow.astro'
import { getCvFileUrl } from '@lib/sanity/siteSettingsQuery'
import { getExternalLinkAttributes } from '@utils/externalLinkAttributes'

/**
 * ContactView Component
 *
 * @description Contact page: title band, direct channels (email, LinkedIn, CV) and the contact form.
 */
const locale = getLangFromUrl(Astro.url)
const t = useTranslations(locale)

const linkedin = themeConfig.socials?.find((social) => social.label === 'LinkedIn')
const cvFileUrl = await getCvFileUrl()

const channelHeaderClass = `flex items-center justify-between gap-2 border-b border-(--border-color) pb-1 micro-label`
const channelLinkClass =
  'inline-flex items-center gap-2 break-all font-(family-name:--font-family-special) text-(length:--font-size-0) leading-tight font-bold tracking-tight text-(--foreground-color)! no-underline! hover:underline!'
---

<Breadcrumb
  ariaLabel={t('detail.breadcrumb')}
  class="border-b border-(--border-color) px-(--grid-gutter) py-2"
  items={[{ label: t('home.label'), href: getHref('/', false, locale) }, { label: t('contact.label') }]}
/>

<PageTitleBand eyebrow={t('contact.eyebrow')} title={t('contact.label')} subtitle={t('contact.subtitle')} />

<div class="grid grid-cols-1 border-b border-(--border-color) lg:grid-cols-2">
  <section
    class="flex flex-col gap-6 border-b border-(--border-color) px-(--grid-gutter) py-(--space-l) lg:border-r lg:border-b-0"
  >
    <div>
      <Eyebrow class="mb-1">{t('contact.channels.eyebrow')}</Eyebrow>
      <h2
        class="mb-2 text-(length:--font-size-1) leading-(--font-size-2) tracking-tight text-(--foreground-color) uppercase"
      >
        {t('contact.channels.title')}
      </h2>
      <p class="text-(length:--font-size--1) leading-relaxed text-(--color-on-surface-variant)">{t('contact.channels.description')}</p>
    </div>

    <div class="flex flex-col gap-2 border-t border-(--border-color) pt-4">
      <div class={channelHeaderClass}>
        <h3 class="micro-label text-(--color-accent-rose-dark)">{t('contact.channel.email.title')}</h3>
        <span class="text-(--color-on-surface-variant)">{t('contact.channel.email.badge')}</span>
      </div>
      <p class="text-(length:--font-size--1) text-(--color-on-surface-variant)">{t('contact.channel.email.text')}</p>
      <a href={`mailto:${themeConfig.contactEmail}`} class={channelLinkClass}>
        {themeConfig.contactEmail}
        <Icon aria-hidden="true" name="lucide:arrow-up-right" size="1.25rem" />
      </a>
    </div>

    {
      linkedin && (
        <div class="flex flex-col gap-2">
          <div class={channelHeaderClass}>
            <h3 class="micro-label text-(--color-accent-rose-dark)">{t('contact.channel.linkedin.title')}</h3>
            <span class="text-(--color-on-surface-variant)">{t('contact.channel.linkedin.badge')}</span>
          </div>
          <p class="text-(length:--font-size--1) text-(--color-on-surface-variant)">{t('contact.channel.linkedin.text')}</p>
          <a href={linkedin.href} target="_blank" rel="noopener noreferrer" class={channelLinkClass}>
            {linkedin.label}
            <Icon aria-hidden="true" name="lucide:arrow-up-right" size="1.25rem" />
            <span class="sr-only">{t('contact.new_tab')}</span>
          </a>
        </div>
      )
    }

    <div class="flex flex-col gap-2">
      <div class={channelHeaderClass}>
        <h3 class="micro-label text-(--color-accent-rose-dark)">{t('contact.channel.cv.title')}</h3>
        <span class="text-(--color-on-surface-variant)">{t('contact.channel.cv.badge')}</span>
      </div>
      <p class="text-(length:--font-size--1) text-(--color-on-surface-variant)">{t('contact.channel.cv.text')}</p>
      <Button
        href={cvFileUrl ?? undefined}
        disabled={!cvFileUrl}
        {...(cvFileUrl ? getExternalLinkAttributes() : {})}
        size="md"
        class="w-full justify-between"
      >
        {t('contact.channel.cv.button')}
        <Icon aria-hidden="true" name="lucide:download" size="1.25rem" />
        {cvFileUrl && <span class="sr-only">{t('contact.new_tab')}</span>}
      </Button>
    </div>
  </section>

  <section class="bg-(--color-surface-container-low) px-(--grid-gutter) py-(--space-l)">
    <ContactForm />
  </section>
</div>

<div class="h-(--space-2xl) border-b border-(--border-color)"></div>
