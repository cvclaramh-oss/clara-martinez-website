---
import PageTitleBand from '@components/PageTitleBand.astro'
import { Notification } from 'accessible-astro-components'
import { getLangFromUrl, useTranslations, getHref } from '@utils/i18n'
import { getCatalogItemsByCategory } from '@lib/sanity/catalogItemsQuery'

const locale = getLangFromUrl(Astro.url)
const t = useTranslations(locale)

const projects = await getCatalogItemsByCategory(locale, 'projects')

const staticPages = [
  {
    title: t('home.label'),
    url: '/',
    description: t('sitemap.pages.home.description'),
  },
  {
    title: t('projects.label'),
    url: '/projects',
    description: t('sitemap.pages.projects.description'),
  },
  {
    title: t('contact.label'),
    url: '/contact',
    description: t('sitemap.pages.contact.description'),
  },
  {
    title: t('accessibility.label'),
    url: '/accessibility-statement',
    description: t('sitemap.pages.accessibility_statement.description'),
  },
  {
    title: t('thank_you.label'),
    url: '/thank-you',
    description: t('sitemap.pages.thank_you.description'),
  },
]
---

  <PageTitleBand title={t('sitemap.label')} subtitle={t('sitemap.subtitle')} />

  <section class="my-(--space-2xl) px-(--grid-gutter)">
    <div class="space-y-12">
      <div>
        <h2 class="mb-6 text-balance">
          {t('sitemap.main_pages')}
        </h2>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            staticPages.map((page) => (
              <article>
                <h3 class="mb-3 text-(length:--font-size-1) leading-(length:--font-size-2) text-balance">
                  <a href={page.url}>{page.title}</a>
                </h3>
                <p class="mb-3">{page.description}</p>
                <p class="text-(length:--font-size--2)">
                  URL:{' '}
                  <code class="rounded bg-neutral-100 px-1 py-0.5 text-(length:--font-size--2) text-neutral-500 dark:bg-neutral-800 dark:text-neutral-500">
                    {page.url}
                  </code>
                </p>
              </article>
            ))
          }
        </div>
      </div>

      <div>
        <h2 class="text-balance">
          {t('projects.label')}
        </h2>
        <p class="mb-6">
          {t('sitemap.explore')} {projects.length} {t('sitemap.projects_suffix')}
        </p>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            projects.map((project) => (
              <article>
                <h3 class="mb-3 text-(length:--font-size-1) leading-(length:--font-size-2) text-balance">
                  <a href={getHref(`/projects/${project.slug}`, false, locale)}>{project.data.title}</a>
                </h3>
                <p class="mb-3">{project.data.subtitle}</p>
              </article>
            ))
          }
        </div>
      </div>

      <Notification type="info" variant="accent" class="rounded-none">
        <div class="space-content">
          <h2 class="mb-4 text-(length:--font-size-1) leading-(length:--font-size-2) text-balance">
            {t('sitemap.technical_info')}
          </h2>
          <ul>
            <li>
              <span class="font-bold">{t('sitemap.xml_sitemap')}</span> {t('sitemap.xml_description')}
              <code>/sitemap.xml</code> {t('sitemap.xml_for')}
            </li>
            <li>
              <strong>{t('sitemap.generated_by')}</strong> @astrojs/sitemap
            </li>
            <li>
              <strong>{t('sitemap.last_updated')}</strong> {t('sitemap.auto_updated')}
            </li>
          </ul>
        </div>
      </Notification>
    </div>
  </section>

<style>
  article {
    border: 1px solid var(--border-color-subtle);
    border-radius: var(--radius-large);
    background-color: var(--background-color);
    padding: 1rem;
  }
</style>
