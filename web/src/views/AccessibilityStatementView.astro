---
import PageTitleBand from '@components/PageTitleBand.astro'
import { Notification } from 'accessible-astro-components'
import { getLangFromUrl, useTranslations } from '@utils/i18n'

/**
 * AccessibilityStatement Component
 *
 * @description The accessibility statement page. The body content is a
 * placeholder pending real authoring with Clara's data.
 * All internal strings are localized via the i18n dictionaries.
 */
const locale = getLangFromUrl(Astro.url)
const t = useTranslations(locale)
---

<PageTitleBand title={t('accessibility.label')} subtitle={t('accessibility.subtitle')} />
<section class="my-16">
  <div class="container space-content">
    <Notification type="info" class="rounded-none">
      <p>{t('accessibility.pending_notice')}</p>
    </Notification>
    <h2 class="text-balance">
      {t('accessibility.commitment')}
    </h2>
    <p>{t('accessibility.placeholder')}</p>
  </div>
</section>