---
import { Icon } from 'astro-icon/components'
import { getLangFromUrl, useTranslations, getHref } from '@utils/i18n'
import { getCatalogItemDetailsByCategory } from '@lib/sanity/catalogItemDetailQuery'
import type { CatalogItemCategory } from '@lib/sanity/catalogItemsQuery'
import { urlFor, imageSize } from '@lib/sanity/imageUrlBuilder'
import { portableTextToHtml } from '@lib/sanity/renders/portableTextRender'
import { CATEGORY_LABEL_KEYS } from '@constants/constLabels'
import { linkResetClassName } from '@constants/constClassNames'
import VideoEmbed from '@components/VideoEmbed.astro'
import { getExternalLinkAttributes } from '@utils/externalLinkAttributes'
import Button from '@components/Button.astro'
import Breadcrumb from '@components/Breadcrumb.astro'
import Eyebrow from '@components/Eyebrow.astro'
import Insignia from '@components/Insignia.astro'

/**
 * CatalogItemDetail Component
 *
 * @description Renders a single catalog item (project, material, formation or workshop) from its full
 * document (getCatalogItemDetailsByCategory): a context bar with the trail and the tags; the
 * header with the title, the subtitle, the single action button and the cover; the long description next to
 * the fact sheet; the gallery with the videos; and the previous and next items of the category (by title). All internal links are localized through getHref.
 */
interface Props {
  /**
   * The category of the item to render
   */
  category: CatalogItemCategory
  /**
   * The slug of the item to render
   */
  slug: string
}

const locale = getLangFromUrl(Astro.url)
const t = useTranslations(locale)
const { category, slug } = Astro.props

const items = await getCatalogItemDetailsByCategory(locale, category)
const item = items.find((entry) => entry.slug === slug)
const data = item?.data

// Previous and next item of the same category and language, in title order.
const sortedItems = [...items].sort((a, b) => a.data.title.localeCompare(b.data.title, locale))
const position = sortedItems.findIndex((entry) => entry.slug === slug)
const previousItem = position > 0 ? sortedItems[position - 1] : undefined
const nextItem = position >= 0 && position < sortedItems.length - 1 ? sortedItems[position + 1] : undefined

// Catalog page the item belongs to: the subcategory page for materials, the category page otherwise.
const catalogPage = data?.subcategory && category === 'materials' ? `materials-${data.subcategory}` : category
const categoryLabel = t(CATEGORY_LABEL_KEYS[category])
const catalogLabel = t(CATEGORY_LABEL_KEYS[catalogPage])
const bodyHtml = portableTextToHtml(data?.descriptionLong)

const coverUrl = urlFor(data?.image, 960)
const coverSize = imageSize(data?.image)

// The button is either a download (file) or a link (url), never both: the Studio validates it. Both open
// in a new tab; files aren't forced to download — the person can open, view and save from there.
const button = data?.button?.visible ? data.button : null
const buttonHref = button ? (button.type === 'download' ? button.fileUrl : button.url) : null
const buttonLabel = button?.label || t(button?.type === 'download' ? 'detail.download' : 'detail.open_link')

const externalHost = (() => {
  try {
    return data?.externalLink ? new URL(data.externalLink).hostname.replace(/^www\./, '') : ''
  } catch {
    return data?.externalLink ?? ''
  }
})()

const documents = (data?.documents ?? []).filter((doc) => doc.fileUrl)
const gallery = data?.gallery ?? []
const videos = (data?.videos ?? []).filter((video) => video.url || video.fileUrl)

// Fact sheet: one row per field that has a value in Sanity, all rendered by the same template. The link and
// document rows below the text rows share the same classes.
const factRowClass = 'grid grid-cols-1 sm:grid-cols-3'
const factTermClass = 'flex items-center bg-(--color-surface-container-low) p-(--space-xs) text-(--color-accent-rose-dark) sm:border-r sm:border-(--border-color) micro-label'
const factValueClass = 'p-(--space-xs) sm:col-span-2'
const factRows = [
  { label: t('detail.category'), value: catalogPage !== category ? `${categoryLabel} / ${catalogLabel}` : categoryLabel },
  { label: t('detail.year'), value: data?.year },
  { label: t('detail.created_by'), value: data?.createdBy },
  { label: t('detail.designed_by'), value: data?.designedBy },
  { label: t('detail.institutional_authorship'), value: data?.institutionalAuthorship },
  { label: t('detail.my_work'), value: data?.myWork },
].filter((row) => row.value)

---

{
  item && data && (
    <>
      <div class="flex flex-col border-b border-(--border-color) md:flex-row md:items-stretch md:justify-between">
        <Breadcrumb
          ariaLabel={t('detail.breadcrumb')}
          class="flex min-w-0 items-center px-(--grid-gutter) py-2"
          items={[
            { label: t('home.label'), href: getHref('/', false, locale) },
            { label: categoryLabel, href: getHref(`/${category}`, false, locale) },
            ...(catalogPage !== category
              ? [{ label: catalogLabel, href: getHref(`/${catalogPage}`, false, locale) }]
              : []),
            { label: data.title },
          ]}
        />
        {data.tags.length > 0 && (
          <div class={`flex flex-wrap items-center gap-2 border-t border-(--border-color) px-(--grid-gutter) py-2 md:border-t-0 md:border-l micro-label`}>
            <span class="text-(--color-accent-rose-dark)">{t('detail.tags')}:</span>
            <ul class="flex flex-wrap gap-1">
              {data.tags.map((tag) => (
                <li>
                  <a
                    href={getHref(`/${catalogPage}/tag/${tag.slug}`, false, locale)}
                    class="inline-flex min-w-6 items-center justify-center border border-(--border-color) px-1.5 py-1.5 text-(--color-on-surface-variant)! no-underline! hover:bg-(--color-surface-container-high) hover:text-(--foreground-color)!"
                  >
                    #{tag.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <section class="grid grid-cols-1 border-b border-(--border-color) lg:grid-cols-12">
        <div
          class:list={[
            'flex flex-col justify-between p-(--grid-gutter)',
            coverUrl ? 'border-b border-(--border-color) lg:col-span-7 lg:border-r lg:border-b-0' : 'lg:col-span-12',
          ]}
        >
          <div>
            <Eyebrow icon class="mb-1">{catalogLabel}</Eyebrow>
            <h1 class="mb-4 text-(length:--font-size-6) leading-(length:--font-size-7) tracking-tight text-(--foreground-color) uppercase">
              {data.title}
            </h1>
            <p class="mb-6 max-w-2xl text-(length:--font-size-1) leading-relaxed text-(--color-on-surface-variant)">{data.subtitle}</p>
          </div>
          {buttonHref && (
            <div class="mt-6 border-t border-(--border-color) pt-4">
              <Button href={buttonHref} {...getExternalLinkAttributes()}>
                <span>{buttonLabel}</span>
                <Icon aria-hidden="true" name={button?.type === 'download' ? 'lucide:download' : 'lucide:external-link'} size="1.25rem" />
                <span class="sr-only">{t('detail.new_tab')}</span>
              </Button>
            </div>
          )}
        </div>
        {coverUrl && (
          <div class="flex items-center justify-center bg-(--color-surface-container-low) p-(--grid-gutter) lg:col-span-5">
            <div class="w-full max-w-md border border-(--border-color) bg-(--background-color) p-2">
              <img
                class="block h-auto w-full"
                src={coverUrl}
                alt={data.imageAlt ?? ''}
                width={coverSize?.width}
                height={coverSize?.height}
                decoding="async"
              />
            </div>
          </div>
        )}
      </section>

      <section class="grid grid-cols-1 border-b border-(--border-color) lg:grid-cols-12">
        <div class="border-b border-(--border-color) p-(--grid-gutter) lg:col-span-7 lg:border-r lg:border-b-0">
          {(bodyHtml || data.sections.length > 0) && (
            <>
              <h2 class="mb-4 border-b border-(--border-color) pb-1 text-(length:--font-size-1) leading-(length:--font-size-2) tracking-tight text-(--foreground-color) uppercase">
                {t('detail.description')}
              </h2>
              <div class="detail-body text-(length:--font-size-0) leading-relaxed text-(--color-on-surface-variant)" set:html={bodyHtml} />
              {data.sections.map((section) => (
                <div class="mt-6">
                  {section.title && <h3 class="mb-1 text-(length:--font-size-0) leading-(length:--font-size-1) tracking-tight text-(--foreground-color) uppercase">{section.title}</h3>}
                  {section.text && <p class="leading-relaxed whitespace-pre-line text-(--color-on-surface-variant)">{section.text}</p>}
                </div>
              ))}
            </>
          )}
        </div>
        <div class="p-(--grid-gutter) lg:col-span-5">
          <h2 class="mb-4 border-b border-(--border-color) pb-1 text-(length:--font-size-1) leading-(length:--font-size-2) tracking-tight text-(--foreground-color) uppercase">
            {t('detail.fact_sheet')}
          </h2>
          <dl class="divide-y divide-(--border-color) border border-(--border-color) text-(length:--font-size--1)">
            {factRows.map((row) => (
              <div class={factRowClass}>
                <dt class={factTermClass}>{row.label}</dt>
                <dd class={`${factValueClass} whitespace-pre-line text-(--foreground-color)`}>{row.value}</dd>
              </div>
            ))}
            {data.externalLink && (
              <div class={factRowClass}>
                <dt class={factTermClass}>{t('detail.external_link')}</dt>
                <dd class={factValueClass}>
                  <a href={data.externalLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 break-all">
                    {externalHost}
                    <Icon aria-hidden="true" name="lucide:arrow-up-right" size="0.875rem" />
                    <span class="sr-only">{t('detail.new_tab')}</span>
                  </a>
                </dd>
              </div>
            )}
            {documents.length > 0 && (
              <div class={factRowClass}>
                <dt class={factTermClass}>{t('detail.documents')}</dt>
                <dd class={factValueClass}>
                  <ul class="space-y-1">
                    {documents.map((doc) => (
                      <li>
                        <a href={doc.fileUrl ?? ''} {...getExternalLinkAttributes()} class="inline-flex items-center gap-1">
                          {doc.title || t('detail.download')}
                          <Icon aria-hidden="true" name="lucide:download" size="0.875rem" />
                          <span class="sr-only">{t('detail.new_tab')}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            )}
          </dl>
        </div>
      </section>

      {(gallery.length > 0 || videos.length > 0) && (
        <section class="overflow-hidden border-b border-(--border-color)">
          <h2 class="sr-only">{t('detail.gallery')}</h2>
          <div class="-mr-px -mb-px grid grid-cols-1 md:grid-cols-3">
            {gallery.map((image, position) => (
              <div class="group relative aspect-4/3 overflow-hidden border-r border-b border-(--border-color) bg-(--color-surface-container-low)">
                <img
                  class="h-full w-full object-cover motion-safe:transition-transform motion-safe:duration-200 motion-safe:group-hover:scale-[1.01]"
                  src={urlFor(image, 800, 600)}
                  alt={image.alt}
                  width="800"
                  height="600"
                  loading="lazy"
                  decoding="async"
                />
                <Insignia tone="light" class="absolute top-2 left-2">
                  {t('detail.figure')}
                  {' '}
                  {String(position + 1).padStart(2, '0')}
                </Insignia>
              </div>
            ))}
            {videos.map((video, position) => (
              <VideoEmbed url={video.url} fileUrl={video.fileUrl} title={video.title} index={position + 1} />
            ))}
          </div>
        </section>
      )}

      {(previousItem || nextItem) && (
        <nav aria-label={t('detail.previous_next')} class="grid grid-cols-1 border-b border-(--border-color) md:grid-cols-2">
          {previousItem && (
            <a
              rel="prev"
              href={getHref(`/${category}/${previousItem.slug}`, false, locale)}
              class={`flex items-center gap-4 border-b border-(--border-color) p-(--grid-gutter) md:col-start-1 md:border-r md:border-b-0 ${linkResetClassName} hover:bg-(--color-surface-container-low)`}
            >
              <Icon aria-hidden="true" name="lucide:arrow-left" size="1.5rem" />
              <span class="flex flex-col gap-1">
                <span class="micro-label text-(--color-on-surface-variant)">{t('detail.previous')}</span>
                <span class="font-(family-name:--font-family-special) text-(length:--font-size-0) leading-tight font-bold uppercase">{previousItem.data.title}</span>
              </span>
            </a>
          )}
          {nextItem && (
            <a
              rel="next"
              href={getHref(`/${category}/${nextItem.slug}`, false, locale)}
              class={`flex items-center justify-between gap-4 p-(--grid-gutter) text-right md:col-start-2 ${linkResetClassName} hover:bg-(--color-surface-container-low)`}
            >
              <span class="ml-auto flex flex-col gap-1">
                <span class="micro-label text-(--color-on-surface-variant)">{t('detail.next')}</span>
                <span class="font-(family-name:--font-family-special) text-(length:--font-size-0) leading-tight font-bold uppercase">{nextItem.data.title}</span>
              </span>
              <Icon aria-hidden="true" name="lucide:arrow-right" size="1.5rem" />
            </a>
          )}
        </nav>
      )}
    </>
  )
}

<style lang="scss">
  .detail-body {
    :global(p + p),
    :global(ul + p),
    :global(p + ul),
    :global(h2 + p) {
      margin-block-start: var(--space-s);
    }

    :global(h2) {
      margin-block-start: var(--space-m);
      font-size: var(--font-size-1);
      line-height: var(--font-size-2);
      letter-spacing: 0;
      text-transform: uppercase;
      color: var(--foreground-color);
    }

    :global(ul) {
      margin-inline-start: 0;
      padding-inline-start: 1.25rem;
      list-style-type: disc;
    }

    :global(li + li) {
      margin-block-start: var(--space-3xs);
    }
  }
</style>
