---
import CatalogCard from '@components/CatalogCard.astro'
import CatalogPagination from '@components/CatalogPagination.astro'
import TagFilterBar from '@components/TagFilterBar.astro'
import MaterialsSubcategoryBar from '@components/MaterialsSubcategoryBar.astro'
import { getLangFromUrl, useTranslations, getHref } from '@utils/i18n'
import { getCatalogPageItems } from '@lib/sanity/catalogItemsQuery'
import { getCatalogTags, filterByTagSlug, type CatalogTag } from '@utils/catalogTags'
import { CATALOG_PAGES, CATALOGS_PAGE_SIZE, type CatalogPage } from '@constants/constCatalog'
import { CATEGORY_LABEL_KEYS } from '@constants/constLabels'
import Breadcrumb from '@components/Breadcrumb.astro'
import PageTitleBand from '@components/PageTitleBand.astro'

/**
 * CatalogsView Component
 *
 * @description Renders one catalog listing (projects, materials or one of its subcategories, formations or
 * workshops): breadcrumb, title band, card grid (or an empty state) and the pagination. All internal links are
 * localized through getHref.
 */
interface Props {
  /**
   * The catalog to list; it decides the items, the title, the subtitle and the route of the pages
   */
  catalogPage: CatalogPage
  /**
   * The page number of the listing to render
   * @default 1
   */
  pageNum?: number
  /**
   * When set, renders only the items carrying this tag (all of them, no pagination) instead of the
   * paginated full listing.
   */
  activeTag?: CatalogTag
}

const locale = getLangFromUrl(Astro.url)
const t = useTranslations(locale)
const { catalogPage, pageNum = 1, activeTag } = Astro.props

const items = await getCatalogPageItems(locale, catalogPage)
const title = t(CATEGORY_LABEL_KEYS[catalogPage])
const isMaterialsSubcategory = CATALOG_PAGES[catalogPage].category === 'materials' && catalogPage !== 'materials'
const catalogTags = getCatalogTags(items)

const filteredItems = activeTag ? filterByTagSlug(items, activeTag.slug) : items
const totalPages = activeTag ? 1 : Math.max(1, Math.ceil(items.length / CATALOGS_PAGE_SIZE))
const startIndex = activeTag ? 0 : (pageNum - 1) * CATALOGS_PAGE_SIZE
const pageItems = activeTag ? filteredItems : items.slice(startIndex, startIndex + CATALOGS_PAGE_SIZE)

const breadcrumbItems = [
  { label: t('home.label'), href: getHref('/', false, locale) },
  ...(isMaterialsSubcategory ? [{ label: t('materials.label'), href: getHref('/materials', false, locale) }] : []),
  ...(activeTag
    ? [{ label: title, href: getHref(`/${catalogPage}`, false, locale) }, { label: `#${activeTag.text}` }]
    : [{ label: title }]),
]
---

<Breadcrumb
  ariaLabel={t('detail.breadcrumb')}
  class="border-b border-(--border-color) px-(--grid-gutter) py-2"
  items={breadcrumbItems}
/>

<PageTitleBand eyebrow={t('catalog.eyebrow')} title={title} subtitle={t(CATALOG_PAGES[catalogPage].subtitleKey)} />

{CATALOG_PAGES[catalogPage].category === 'materials' && <MaterialsSubcategoryBar activeCatalogPage={catalogPage} />}

{catalogTags.length > 0 && <TagFilterBar tags={catalogTags} activeSlug={activeTag?.slug} catalogPage={catalogPage} />}

<div class="h-(--space-l) border-b border-(--border-color)" />

{
  pageItems.length === 0 ? (
    <section class="border-b border-(--border-color) px-(--grid-gutter) py-(--space-xl-2xl)">
      <h2 class="mb-2 text-(length:--font-size-2) leading-(--font-size-3) text-(--foreground-color) uppercase">
        {t('catalog.empty_title')}
      </h2>
      <p class="mb-4 max-w-2xl text-(--color-on-surface-variant)">{t('catalog.empty_text')}</p>
    </section>
  ) : (
    <div class="overflow-hidden">
      <div class="-mr-px grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
        {pageItems.map((item) => (
          <CatalogCard item={item} headingLevel="h2" showCategory={catalogPage === 'materials'} />
        ))}
      </div>
    </div>
  )
}

{
  !activeTag && (
    <CatalogPagination
      pageNum={pageNum}
      totalPages={totalPages}
      totalItems={items.length}
      shownItems={pageItems.length}
      basePath={`/${catalogPage}`}
    />
  )
}

<div class="h-(--space-2xl) border-b border-(--border-color)"></div>
