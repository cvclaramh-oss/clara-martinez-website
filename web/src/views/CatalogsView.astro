---
import CatalogCard from '@components/CatalogCard.astro'
import CatalogPagination from '@components/CatalogPagination.astro'
import { getLangFromUrl, useTranslations, getHref } from '@utils/i18n'
import { getCatalogItemsByCategory } from '@lib/sanity/catalogItemsQuery'
import { CATALOGS_PAGE_SIZE } from '@constants/constCatalog'

/**
 * CatalogsView Component
 *
 * @description Renders the project collection: breadcrumb, title band, card grid (or an empty state) and
 * the pagination. All internal links are localized through getHref.
 */
interface Props {
  /**
   * The page number of the listing to render
   * @default 1
   */
  pageNum?: number
}

const locale = getLangFromUrl(Astro.url)
const t = useTranslations(locale)
const { pageNum = 1 } = Astro.props

const projects = await getCatalogItemsByCategory(locale, 'projects')

const totalPages = Math.max(1, Math.ceil(projects.length / CATALOGS_PAGE_SIZE))
const startIndex = (pageNum - 1) * CATALOGS_PAGE_SIZE
const pageProjects = projects.slice(startIndex, startIndex + CATALOGS_PAGE_SIZE)

const labelClass =
  'font-(family-name:--font-family-special) text-[0.6875rem] leading-3.5 font-bold tracking-widest uppercase'
---

<nav aria-label={t('detail.breadcrumb')} class="border-b border-(--border-color) px-4 py-2 md:px-6 lg:px-8">
  <ol class={`flex flex-wrap items-center gap-1 text-(--color-on-surface-variant) ${labelClass}`}>
    <li>
      <a href={getHref('/', false, locale)} class="text-(--color-on-surface-variant)! no-underline! hover:underline!">
        {t('home.label')}
      </a>
    </li>
    <li aria-hidden="true">/</li>
    <li aria-current="page" class="text-(--foreground-color)">{t('projects.label')}</li>
  </ol>
</nav>

<section class="border-b border-(--border-color) px-4 py-8 md:px-6 lg:px-8 lg:py-10">
  <div class="max-w-4xl">
    <div class="mb-1 flex items-center gap-1">
      <span class="inline-block h-2.5 w-2.5 bg-(--foreground-color)"></span>
      <span
        class="font-(family-name:--font-family-special) text-[0.6875rem] leading-3.5 font-bold tracking-widest text-(--color-accent-rose-dark) uppercase"
      >
        {t('catalog.eyebrow')}
      </span>
    </div>
    <h1
      class="mb-4 font-(family-name:--font-family-special) text-[2.75rem] leading-12 font-bold tracking-tight text-(--foreground-color) uppercase lg:text-7xl lg:leading-19"
    >
      {t('projects.label')}
    </h1>
    <p class="max-w-2xl text-lg leading-relaxed text-(--color-on-surface-variant)">{t('projects.subtitle')}</p>
  </div>
</section>

{
  projects.length === 0 ? (
    <section class="border-b border-(--border-color) px-4 py-12 md:px-6 lg:px-8 lg:py-16">
      <h2 class="mb-2 font-(family-name:--font-family-special) text-2xl leading-8 font-bold text-(--foreground-color) uppercase">
        {t('catalog.empty_title')}
      </h2>
      <p class="mb-4 max-w-2xl text-(--color-on-surface-variant)">{t('catalog.empty_text')}</p>
      <a
        href={getHref('/', false, locale)}
        class={`${labelClass} text-(--foreground-color)! underline! hover:no-underline!`}
      >
        {t('back_home')}
      </a>
    </section>
  ) : (
    <div class="overflow-hidden">
      <div class="-mr-px grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
        {pageProjects.map((project) => (
          <CatalogCard item={project} headingLevel="h2" showCategory={false} />
        ))}
      </div>
    </div>
  )
}

<CatalogPagination
  pageNum={pageNum}
  totalPages={totalPages}
  totalItems={projects.length}
  shownItems={pageProjects.length}
  basePath="/projects"
/>

<div class="h-20 border-b border-(--border-color)"></div>
