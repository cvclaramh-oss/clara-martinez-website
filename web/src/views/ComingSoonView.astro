---
import { Heading, Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import { getLangFromUrl, useTranslations, getHref } from '@utils/i18n'

interface Props {
  sectionLabel?: string
}

const { sectionLabel } = Astro.props
const locale = getLangFromUrl(Astro.url)
const t = useTranslations(locale)
---

<section class="my-12">
  <div class="container">
    <Heading level="h1">{sectionLabel ?? t('coming_soon.title')}</Heading>
  </div>
</section>

<section class="my-12">
  <div class="space-content container">
    <p class="text-2xl">{t('coming_soon.message')}</p>
    <Link href={getHref('/', false, locale)} isButton type="primary" animateOnHover animationType="nudge">
      {t('coming_soon.back_home')}
      <Icon aria-hidden="true" name="lucide:home" size="1.5rem" />
    </Link>
  </div>
</section>