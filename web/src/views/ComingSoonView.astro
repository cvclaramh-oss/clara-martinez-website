---
import { getLangFromUrl, useTranslations, getHref } from '@utils/i18n'
import Button from '@components/Button.astro'
import PageTitleBand from '@components/PageTitleBand.astro'

interface Props {
  sectionLabel?: string
}

const { sectionLabel } = Astro.props
const locale = getLangFromUrl(Astro.url)
const t = useTranslations(locale)
---

<PageTitleBand title={sectionLabel ?? t('coming_soon.title')} />

<section class="my-12">
  <div class="space-content container">
    <p class="text-2xl">{t('coming_soon.message')}</p>
    <Button href={getHref('/', false, locale)} animateOnHover animationType="nudge">
      {t('back_home')}
    </Button>
  </div>
</section>