---
import CallToAction from './CallToAction.astro'
import Logo from './Logo.astro'
import { Heading, Link } from 'accessible-astro-components'
import { getLangFromUrl, useTranslations } from '@utils/i18n'

/**
 * Footer Component
 *
 * @description A component that displays the footer of the website
 */

const locale = getLangFromUrl(Astro.url)
const t = useTranslations(locale)
const currentYear = new Date().getFullYear()
---

<footer>
  <CallToAction />
  <section class="py-20">
    <Heading level="h2" class="sr-only">{t('footer.sr_only')}</Heading>
    <div class="container grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      <div class="flex flex-col gap-4">
        <Heading level="h3" size="h6">{t('footer.navigation')}</Heading>
        <ul class="flex flex-col gap-2">
          <li><Link href="/">{t('footer.home')}</Link></li>
          <li><Link href="/projects">{t('footer.projects')}</Link></li>
          <li><Link href="/contact">{t('footer.contact')}</Link></li>
        </ul>
      </div>
      <div class="flex flex-col gap-4">
        <Heading level="h3" size="h6">{t('footer.accessibility')}</Heading>
        <ul class="flex flex-col gap-2">
          <li><Link href="/accessibility-statement">{t('footer.accessibility_statement')}</Link></li>
          <li><Link href="/sitemap">{t('footer.sitemap')}</Link></li>
        </ul>
      </div>
      <div class="flex flex-col gap-4">
        <Logo />
      </div>
    </div>
  </section>
  <section class="py-8">
    <div class="container flex flex-col gap-4 md:flex-row md:justify-between">
      <p>
        &copy; {currentYear} Clara Martínez Hernández. {t('footer.rights')}
      </p>
    </div>
  </section>
</footer>

<style>
  section {
    border-top: 1px solid var(--border-color-subtle);
  }
</style>
